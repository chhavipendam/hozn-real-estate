# Copy this file to .env for local development.
# In production (Render/Railway/etc.), set these in the host's dashboard
# instead of committing a real .env file.

PORT=5000
NODE_ENV=development

# Secret used to sign JWTs. Use a long random string in production,
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# --- Database ---
# Option A: individual fields (used locally / if DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=real_estate_db
DB_NAME_TEST=real_estate_db_test
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# Option B: a single connection string, as provided by managed Postgres
# hosts like Render/Railway/Supabase. If set, this takes priority over
# the individual DB_* fields above.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# URL of your deployed frontend, used to restrict CORS in production
# e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
